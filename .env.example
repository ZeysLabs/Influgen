# InfluGen — Environment Variables
# Copy this file to `.env.local` and fill in your actual values.

# ------------------------------------------------------------------
# n8n Webhook Configuration
# ------------------------------------------------------------------
# Your n8n webhook URL that triggers the image generation workflow.
# This must be a reachable URL that accepts POST requests.
N8N_WEBHOOK_URL=http://5.175.136.114:5678/webhook-test/influgen-generate

# Optional: Secret key for webhook authentication.
# n8n will send this in the X-Webhook-Secret header.
# Leave empty if your webhook does not require authentication.
N8N_WEBHOOK_SECRET=123456

# ------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------
# Your app's public base URL. Used to build callback URLs for the n8n webhook.
# Must be reachable by your n8n instance so it can POST back to /api/webhook/n8n.
APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# ------------------------------------------------------------------
# CURL EXAMPLES — How to Test Webhooks & Endpoints
# ------------------------------------------------------------------
# Copy these commands into your terminal after running `npm run dev`.
# Make sure APP_URL and N8N_WEBHOOK_URL match your actual setup.
# ------------------------------------------------------------------

# ---
# 1. Test /api/generate-image (sends payload to n8n webhook)
# ---
curl -X POST http://localhost:3000/api/generate-image \
  -H "Content-Type: application/json" \
  -d '{
    "promptId": "prompt-1714823456789",
    "category": "Fashion",
    "selections": {
      "subject": "Model",
      "gender": "Female",
      "outfit": "Evening"
    },
    "jsonPrompt": {
      "category": "Fashion",
      "subject": "Model",
      "gender": "Female",
      "outfit": "Evening"
    },
    "finalPrompt": "Fashion visual — subject: Model, gender: Female, outfit: Evening"
  }'
# Expected response: { "success": true, "message": "Generation started...", "promptId": "..." }

# ---
# 2. Test /api/webhook/n8n (simulates n8n sending back the generated image URL)
# ---
# First, run the generate-image request above (or any valid promptId),
# then replace PROMPT_ID with the actual promptId and run this:
curl -X POST http://localhost:3000/api/webhook/n8n \
  -H "Content-Type: application/json" \
  -d '{
    "promptId": "PROMPT_ID_HERE",
    "imageUrl": "https://via.placeholder.com/512",
    "status": "completed"
  }'
# Expected response: { "success": true }

# To test a failed generation callback:
curl -X POST http://localhost:3000/api/webhook/n8n \
  -H "Content-Type: application/json" \
  -d '{
    "promptId": "PROMPT_ID_HERE",
    "status": "failed",
    "error": "Midjourney queue full, retry later"
  }'
# Expected response: { "success": true }

# ---
# 3. Test /api/prompts/[id] (poll for prompt status)
# ---
# Replace PROMPT_ID with the actual promptId you want to check:
curl -X GET http://localhost:3000/api/prompts/PROMPT_ID_HERE \
  -H "Content-Type: application/json"
# Expected response (completed): { "success": true, "data": { "promptId": "...", "status": "completed", "imageUrl": "..." } }
# Expected response (pending):   { "success": true, "data": { "promptId": "...", "status": "pending", "imageUrl": null } }
# Expected response (not found): { "success": false, "error": "Prompt not found." }

# ---
# 4. Test with n8n webhook secret
# ---
curl -X POST http://localhost:3000/api/webhook/n8n \
  -H "Content-Type: application/json" \
  -H "X-Webhook-Secret: 123456" \
  -d '{
    "promptId": "prompt-test-secret",
    "imageUrl": "https://via.placeholder.com/512",
    "status": "completed"
  }'
# Expected response (correct secret): { "success": true }
# Expected response (wrong secret):   { "success": false, "error": "Unauthorized." }

# ---
# 5. Full end-to-end flow test (step by step)
# ---
# Step 1: Generate a prompt (copy the returned promptId)
# Step 2: Simüle edilmiş n8n callback gönder (use the promptId)
# Step 3: Dashboard'ta veya curl ile GET /api/prompts/[id] ile kontrol et
# Step 4: Dashboard'ta "Generating..." -> görselin yüklendiğini gör

# ---
# Notes
# ---
# - N8N_WEBHOOK_URL: If you are using a local n8n instance behind a firewall,
#   make sure your Next.js app can reach it. Use a tunnel like ngrok if needed.
# - APP_URL: Must be publicly reachable by n8n for the callback to work in production.
# - N8N_WEBHOOK_SECRET: Optional in dev, but strongly recommended in production.
